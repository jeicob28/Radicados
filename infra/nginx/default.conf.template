# Resolver interno de Docker + variables en proxy_pass: nginx vuelve a
# resolver api/web cada `valid` segundos en vez de fijar la IP al arrancar.
# Sin esto, recrear el contenedor de api o web (redeploy) deja al proxy
# apuntando a una IP muerta hasta que se reinicie manualmente (502).
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    client_max_body_size 50m;

    # Cabeceras de seguridad
    add_header X-Content-Type-Options   "nosniff" always;
    add_header X-Frame-Options          "SAMEORIGIN" always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection         "1; mode=block" always;

    # API
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass         http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Consola de MinIO (opcional, útil en desarrollo) — comentar en producción
    # location /minio/ { proxy_pass http://minio:9001/; }

    # Frontend (SPA)
    location / {
        set $web_upstream "${WEB_UPSTREAM}";
        proxy_pass         http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host             $host;
        proxy_set_header   Upgrade          $http_upgrade;
        proxy_set_header   Connection       "upgrade";
        proxy_set_header   X-Forwarded-For  $proxy_add_x_forwarded_for;
    }
}
