# ─────────────────────────────────────────────────────────────
# SGDEA · Sistema de Radicación y Gestión Documental
# Copia este archivo a .env y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Zona horaria (afecta fecha/hora de radicación y cálculo de días hábiles)
TZ=America/Bogota

# Puerto público del proxy (punto de entrada de la aplicación)
HTTP_PORT=8080

# PostgreSQL
POSTGRES_USER=radicados
POSTGRES_PASSWORD=radicados_dev
POSTGRES_DB=radicados

# Cadena de conexión que usan api y worker (host = nombre del servicio en compose)
DATABASE_URL=postgresql://radicados:radicados_dev@postgres:5432/radicados?schema=public

# Redis (colas BullMQ + caché)
REDIS_URL=redis://redis:6379

# MinIO (almacén de objetos S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_BUCKET=radicados

# API
API_PORT=3000

# JWT (se usan a partir de la Fase 1 — CAMBIAR en cualquier entorno real)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Token compartido api <-> worker para endpoints internos (F3+)
INTERNAL_TOKEN=dev_internal_token_change_me

# Buzón institucional IMAP (F5, opcional — si se omite, el worker no revisa correo)
# IMAP_HOST=imap.empresa.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=radicacion@empresa.com
# IMAP_PASSWORD=
